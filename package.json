{
  "name": "yren-live",
  "productName": "YREN LIVE",
  "version": "0.7.0",
  "description": "YREN LIVE — Audio Sequence System. Tu alabanza, en perfecta armonía.",
  "main": "main.js",
  "author": "Nery Barillas",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --publish never",
    "dist:universal": "electron-builder --mac dmg --universal --publish never",
    "test": "node tests/unit-lyrics.mjs && node tests/unit-markers.mjs && node tests/unit-midi.mjs && node tests/unit-platform.mjs && node tests/run-remote.mjs && node tests/run-engine.mjs && node tests/run-ui.mjs && node tests/run-layout.mjs && node tests/run-v02.mjs && node tests/run-v03.mjs && node tests/run-v04.mjs && node tests/run-v05.mjs && node tests/run-v06.mjs",
    "test:engine": "node tests/run-engine.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:layout": "node tests/run-layout.mjs",
    "test:v02": "node tests/run-v02.mjs",
    "test:v03": "node tests/run-v03.mjs",
    "test:unit": "node tests/unit-lyrics.mjs && node tests/unit-markers.mjs && node tests/unit-midi.mjs && node tests/run-remote.mjs && node tests/unit-platform.mjs",
    "test:v04": "node tests/run-v04.mjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "test:v05": "node tests/run-v05.mjs",
    "test:v06": "node tests/run-v06.mjs"
  },
  "build": {
    "appId": "gt.diosdepactos.yrenlive",
    "productName": "YREN LIVE",
    "files": [
      "main.js",
      "preload.js",
      "remote-server.js",
      "platform.js",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "YREN LIVE solo necesita este permiso para leer los nombres de tus salidas de audio (interfaz USB). No graba nada."
      }
    },
    "dmg": {
      "title": "YREN LIVE"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YREN-LIVE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YREN LIVE",
      "language": "3082",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.16.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
