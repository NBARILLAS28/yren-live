{
  "name": "yren-live",
  "productName": "YREN LIVE",
  "version": "0.3.0",
  "description": "YREN LIVE — Audio Sequence System. Tu alabanza, en perfecta armonía.",
  "main": "main.js",
  "author": "Nery Barillas",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg",
    "dist:universal": "electron-builder --mac dmg --universal",
    "test": "node tests/run-engine.mjs && node tests/run-ui.mjs && node tests/run-layout.mjs && node tests/run-v02.mjs && node tests/run-v03.mjs",
    "test:engine": "node tests/run-engine.mjs",
    "test:ui": "node tests/run-ui.mjs",
    "test:electron": "node tests/electron-smoke.mjs",
    "test:layout": "node tests/run-layout.mjs",
    "test:v02": "node tests/run-v02.mjs",
    "test:v03": "node tests/run-v03.mjs"
  },
  "build": {
    "appId": "gt.diosdepactos.yrenlive",
    "productName": "YREN LIVE",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "YREN LIVE solo necesita este permiso para leer los nombres de tus salidas de audio (interfaz USB). No graba nada."
      }
    },
    "dmg": {
      "title": "YREN LIVE"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.16.0"
  }
}
